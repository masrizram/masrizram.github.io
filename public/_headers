/*
 * Security headers — berlaku otomatis di Netlify & Cloudflare Pages
 * (platform membaca file public/_headers). Untuk GitHub Pages, header ini
 * diabaikan; gunakan custom domain + CDN (Cloudflare) atau reverse proxy agar aktif.
 * Catatan: HSTS / header berbasis HTTPS hanya efektif dengan koneksi HTTPS.
 */

/*
 * Mengunci semua origin, izinkan hanya aset & font sendiri + Unsplash (gambar).
 * Sesuaikan 'img-src' jika Anda menaruh gambar di domain lain.
 */
Content-Security-Policy: default-src 'self'; img-src 'self' https://images.unsplash.com data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

/* Lindungi dari clickjacking (embed di iframe orang lain). */
X-Frame-Options: SAMEORIGIN

/* Cegah MIME-sniffing (file dijalankan sebagai tipe lain). */
X-Content-Type-Options: nosniff

/* Batasi pengiriman Referrer ke origin saja (privasi). Juga di-set via <meta>. */
Referrer-Policy: strict-origin-when-cross-origin

/* Nonaktifkan fitur browser yang tidak dipakai (perlu HTTPS). */
Permissions-Policy: geolocation=(), microphone=(), camera=()

/* Cross-Origin Isolation (aman untuk situs statis). */
Cross-Origin-Resource-Policy: same-origin
