---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";
import { site } from "@/lib/site";

const items = [
  { t: "Sistem Pakar KPRJ", d: "Diagnosis dental berbasis rule (Forward Chaining) — skripsi mahasiswa.", img: "https://images.unsplash.com/photo-1561070791-2526d30994b5?w=1400&h=900&auto=format&fit=crop&q=80", cat: "Sistem Pakar" },
  { t: "Panduan RHCSA/EX200", d: "Materi persiapan sertifikasi Red Hat, dari nol hingga lulus.", img: "https://images.unsplash.com/photo-1558655146-9f40138edfeb?w=1400&h=900&auto=format&fit=crop&q=80", cat: "Sertifikasi" },
  { t: "Situs Dokumentasi Astro", d: "Dokumentasi teknis dengan Starlight + shadcn/ui.", img: "https://images.unsplash.com/photo-1559028012-481c04fa702d?w=1400&h=900&auto=format&fit=crop&q=80", cat: "Web" },
  { t: "Aplikasi Web PHP/MySQL", d: "Sistem informasi akademik untuk kebutuhan kampus.", img: "https://images.unsplash.com/photo-1517292987719-0369a794ec0f?w=1400&h=900&auto=format&fit=crop&q=80", cat: "Web" },
  { t: "Workshop Tailwind", d: "Pelatihan styling modern untuk mahasiswa dan dosen.", img: "https://images.unsplash.com/photo-1559028012-481c04fa702d?w=1400&h=900&auto=format&fit=crop&q=80", cat: "Workshop" },
  { t: "Repo Pembelajaran", d: "Kumpulan contoh kode open-source untuk perkuliahan.", img: "https://images.unsplash.com/photo-1607799279861-4dd421887fb3?w=1400&h=900&auto=format&fit=crop&q=80", cat: "Open Source" },
];
---

<BaseLayout title="Portfolio — Nilma, M.Kom." description="Karya, project, dan materi yang dibimbing atau dibuat oleh " + site.fullName + ".">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight">Portfolio</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">Karya, project bimbingan, dan materi yang saya buat.</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <article class="group overflow-hidden rounded-xl border border-border bg-card transition-colors hover:border-primary/50">
          <div class="aspect-[16/10] overflow-hidden bg-muted">
            <img src={item.img} alt={item.t} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform group-hover:scale-105" />
          </div>
          <div class="p-4">
            <span class="text-xs text-primary">{item.cat}</span>
            <h3 class="mt-1 font-semibold">{item.t}</h3>
            <p class="text-sm text-muted-foreground">{item.d}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-10">
      <Button asChild variant="secondary"><a href="/contact/">Punya ide kolaborasi? Hubungi saya →</a></Button>
    </div>
  </div>
</BaseLayout>
