---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/utils';
import { Button } from '@/components/ui/button';

const items = (await getCollection('portfolio', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Portfolio" description="Karya, project, dan materi yang dibimbing atau dibuat oleh Nilma, M.Kom.">
    <div class="mx-auto max-w-6xl px-6 py-20">
        <h1 class="text-4xl font-bold tracking-tight">Portfolio</h1>
        <p class="mt-3 max-w-2xl text-muted-foreground">Karya, project bimbingan, dan materi yang saya buat.</p>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
                items.map((item) => (
                    <a
                        href={withBase(`/portfolio/${item.id}/`)}
                        class="group overflow-hidden rounded-xl border border-border bg-card transition-colors hover:border-primary/50"
                    >
                        <div class="aspect-[16/10] overflow-hidden bg-muted">
                            {item.data.img && (
                                <img
                                    src={item.data.img}
                                    alt={item.data.title}
                                    loading="lazy"
                                    decoding="async"
                                    class="h-full w-full object-cover transition-transform group-hover:scale-105"
                                />
                            )}
                        </div>
                        <div class="p-4">
                            <span class="text-xs text-primary">{item.data.category}</span>
                            <h3 class="mt-1 font-semibold group-hover:text-primary">{item.data.title}</h3>
                            <p class="text-sm text-muted-foreground">{item.data.description}</p>
                        </div>
                    </a>
                ))
            }
        </div>

        <div class="mt-10">
            <Button asChild variant="secondary"
                ><a href={withBase('/contact/')}>Punya ide kolaborasi? Hubungi saya →</a></Button
            >
        </div>
    </div>
</BaseLayout>
