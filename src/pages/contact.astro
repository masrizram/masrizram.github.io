---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/ui/button';
import { site } from '@/lib/site';
import { withBase } from '@/lib/utils';

const faq = [
    {
        q: 'Bisa bantu pengembangan aplikasi full-stack?',
        a: 'Ya, mulai dari frontend, backend, hingga deployment infrastruktur.',
    },
    {
        q: 'Apakah ada materi persiapan RHCSA berbayar?',
        a: 'Materi dasar gratis di Docs; sesi mentoring bisa diatur secara personal.',
    },
    {
        q: 'Bisa bantu audit/penetration test aplikasi web?',
        a: 'Tentu, termasuk review keamanan kode dan penyusunan laporan mitigasi.',
    },
];

// Situs statis tanpa backend. Form dirakit menjadi mailto: lengkap (subject+body)
// oleh script kecil saat submit — sehingga isi pesan BENAR-BENAR terbawa.
// Tanpa JavaScript, tombol cadangan di bawah tetap membuka email client.
const mailtoFallback = `mailto:${site.email}?subject=${encodeURIComponent('Halo ' + site.name + ' — pesan dari situs')}`;
---

<BaseLayout
    title="Contact"
    description="Hubungi Sutan Rizki Ramdani untuk kolaborasi, riset keamanan, atau pengembangan aplikasi."
    faq={faq}
    breadcrumbs={[{ label: 'Contact', href: '/contact/' }]}
>
    <div class="mx-auto max-w-3xl px-6 py-20">
        <h1 class="text-4xl font-bold tracking-tight">Contact</h1>

        <!-- 1. INTRO -->
        <p class="mt-3 max-w-2xl text-muted-foreground">
            Punya proyek yang ingin dibangun, butuh <strong class="text-foreground">audit keamanan</strong>, atau ingin
            berkolaborasi? Saya terbuka untuk kolaborasi & riset keamanan. Prinsip saya sederhana:
            <strong class="text-foreground">transparan sejak hari pertama</strong>, konsultasi gratis, dan
            <strong class="text-foreground">kode & laporan sepenuhnya milik Anda</strong>.
        </p>

        <!-- 2. FORM -->
        <form id="konsultasi" class="mt-8 grid gap-4 sm:grid-cols-2" action={mailtoFallback} method="get">
            <div class="flex flex-col gap-1">
                <label for="cf-nama" class="text-sm font-medium text-foreground">Nama</label>
                <input
                    id="cf-nama"
                    name="nama"
                    required
                    class="rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring"
                    placeholder="Nama"
                />
            </div>
            <div class="flex flex-col gap-1">
                <label for="cf-email" class="text-sm font-medium text-foreground">Email</label>
                <input
                    id="cf-email"
                    name="email"
                    required
                    type="email"
                    class="rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring"
                    placeholder="Email"
                />
            </div>
            <div class="flex flex-col gap-1 sm:col-span-2">
                <label for="cf-pesan" class="text-sm font-medium text-foreground">Pesan</label>
                <textarea
                    id="cf-pesan"
                    name="pesan"
                    required
                    rows="5"
                    class="rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring sm:col-span-2"
                    placeholder="Pesan"></textarea>
            </div>
            <div class="flex flex-wrap items-center gap-3 sm:col-span-2">
                <Button type="submit">Kirim Pesan</Button>
                <span id="cf-status" class="text-xs text-muted-foreground" role="status" aria-live="polite">
                    Tombol ini membuka aplikasi email Anda dengan pesan sudah terisi — mudah dan tanpa form backend.
                </span>
            </div>
        </form>

        <!--
            Merakit mailto: lengkap saat submit. Ini memperbaiki bug lama:
            `<form action="mailto:" method="get">` diabaikan browser modern,
            sehingga klik Kirim tidak melakukan apa pun (silent failure).
        -->
        <script is:inline define:vars={{ email: site.email }}>
            (function () {
                const form = document.getElementById('konsultasi');
                if (!form) return;

                // Rakit mailto: lengkap (subject + body) dari isi form.
                function buildMailto() {
                    const data = new FormData(form);
                    const nama = String(data.get('nama') || '').trim();
                    const dari = String(data.get('email') || '').trim();
                    const pesan = String(data.get('pesan') || '').trim();
                    const subject = 'Pesan dari situs — ' + (nama || 'Pengunjung');
                    const body = 'Nama: ' + nama + '\nEmail: ' + dari + '\n\n' + pesan;
                    return (
                        'mailto:' +
                        email +
                        '?subject=' +
                        encodeURIComponent(subject) +
                        '&body=' +
                        encodeURIComponent(body)
                    );
                }

                function sync() {
                    form.setAttribute('action', buildMailto());
                }
                form.addEventListener('input', sync);
                form.addEventListener('submit', function () {
                    sync();
                    const status = document.getElementById('cf-status');
                    if (status) {
                        status.textContent =
                            'Membuka aplikasi email Anda… jika tidak muncul, salin alamat ' + email + ' secara manual.';
                    }
                });
                sync();
            })();
        </script>

        <!-- 3. CONTACT INFO -->
        <div class="mt-10 flex flex-wrap gap-6 text-sm text-muted-foreground">
            <span>📧 {site.email}</span>
            <span>📍 Indonesia (remote)</span>
            <span
                class="rounded-full border border-emerald-500/40 bg-emerald-500/10 px-3 py-1 text-emerald-700 dark:text-emerald-300"
            >
                ✓ Konsultasi gratis 30 menit · Kode &amp; laporan milik Anda
            </span>
        </div>

        <!-- 4. FAQ INLINE -->
        <h2 class="mt-12 text-2xl font-bold tracking-tight">Pertanyaan Umum</h2>
        <div class="mt-4 space-y-4">
            {
                faq.map((f) => (
                    <div class="rounded-xl border border-border bg-card p-4">
                        <p class="font-medium text-foreground">{f.q}</p>
                        <p class="mt-1 text-sm text-muted-foreground">{f.a}</p>
                    </div>
                ))
            }
        </div>

        <!-- 5. CTA -->
        <div
            class="mt-12 rounded-2xl border border-primary/30 bg-gradient-to-br from-primary/5 to-transparent p-8 text-center"
        >
            <h2 class="text-2xl font-bold tracking-tight">Mulai kolaborasi</h2>
            <p class="mt-2 text-muted-foreground">
                Diskusikan Proyek Anda atau mulai kolaborasi — konsultasi gratis 30 menit, tanpa biaya, tanpa ikatan.
            </p>
            <div class="mt-6 flex flex-wrap justify-center gap-3">
                <Button asChild size="lg"><a href={withBase('/contact/') + '#konsultasi'}>Konsultasi Gratis</a></Button>
                <Button asChild size="lg" variant="outline"><a href={`mailto:${site.email}`}>Hubungi Saya</a></Button>
            </div>
        </div>
    </div>
</BaseLayout>
