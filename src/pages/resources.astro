---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";

const resources = [
  { cat: "Sertifikasi", items: [
    { t: "Panduan RHCSA/EX200 (MkDocs)", href: "/guides/contoh/", d: "Materi persiapan sertifikasi Red Hat." },
    { t: "Cheat sheet Perintah Linux", href: "/guides/contoh/", d: "Referensi cepat perintah harian." },
  ]},
  { cat: "Web & Dokumentasi", items: [
    { t: "Astro + Starlight Starter", href: "/guides/contoh/", d: "Template dokumentasi siap pakai." },
    { t: "shadcn/ui di Astro", href: "/guides/contoh/", d: "Cara pasang komponen UI modern." },
  ]},
  { cat: "Sistem Pakar", items: [
    { t: "Forward Chaining 101", href: "/guides/contoh/", d: "Konsep & contoh rule engine." },
    { t: "Contoh Skripsi Sistem Pakar", href: "/portfolio/", d: "Kumpulan ide topik skripsi." },
  ]},
];
const external = [
  { t: "Repositori GitHub", href: "https://github.com/masrizram" },
  { t: "Tailwind CSS", href: "https://tailwindcss.com" },
  { t: "Astro Docs", href: "https://docs.astro.build" },
  { t: "Starlight", href: "https://starlight.astro.build" },
];
---

<BaseLayout title="Resources — Nilma, M.Kom." description="Kumpulan materi, panduan, dan tautan berguna.">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight">Resources</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">Materi, panduan, dan tautan yang saya kurasi untuk mahasiswa & rekan dosen.</p>

    <div class="mt-10 space-y-10">
      {resources.map((group) => (
        <section>
          <h2 class="text-xl font-bold tracking-tight">{group.cat}</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {group.items.map((r) => (
              <a href={r.href} class="group rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/50">
                <h3 class="font-semibold group-hover:text-primary">{r.t}</h3>
                <p class="mt-1 text-sm text-muted-foreground">{r.d}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <h2 class="mt-12 text-xl font-bold tracking-tight">Tautan Eksternal</h2>
    <div class="mt-4 flex flex-wrap gap-3">
      {external.map((e) => (
        <a href={e.href} class="rounded-full border border-border bg-muted px-4 py-2 text-sm transition-colors hover:bg-accent">{e.t}</a>
      ))}
    </div>

    <div class="mt-10">
      <Button asChild variant="secondary"><a href="/contact/">Minta resource lain →</a></Button>
    </div>
  </div>
</BaseLayout>
