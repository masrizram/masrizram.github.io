---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/ui/button';
import { withBase } from '@/lib/utils';

const items = (await getCollection('teaching', ({ data }) => !data.draft)).sort((a, b) =>
    a.data.type === b.data.type ? 0 : a.data.type === 'Mata Kuliah' ? -1 : 1,
);
---

<BaseLayout title="Teaching" description="Mata kuliah, workshop, dan materi perkuliahan yang saya ajarkan.">
    <div class="mx-auto max-w-6xl px-6 py-20">
        <h1 class="text-4xl font-bold tracking-tight">Teaching</h1>
        <p class="mt-3 max-w-2xl text-muted-foreground">
            Mata kuliah, workshop, dan materi yang saya ajarkan serta bimbing.
        </p>

        <div class="mt-10 space-y-10">
            {
                ['Mata Kuliah', 'Workshop'].map((tipe) => {
                    const group = items.filter((i) => i.data.type === tipe);
                    if (!group.length) return null;
                    return (
                        <section>
                            <h2 class="text-xl font-bold tracking-tight">{tipe}</h2>
                            <div class="mt-4 space-y-4">
                                {group.map((c) => (
                                    <a
                                        href={withBase(`/teaching/${c.id}/`)}
                                        class="flex flex-col gap-2 rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/50 sm:flex-row sm:items-center sm:justify-between"
                                    >
                                        <div>
                                            <p class="font-mono text-xs text-primary">
                                                {c.data.code ?? '—'} · {c.data.semester ?? ''}
                                            </p>
                                            <h3 class="mt-1 font-semibold group-hover:text-primary">{c.data.title}</h3>
                                            <p class="text-sm text-muted-foreground">{c.data.description}</p>
                                        </div>
                                        <span class="text-sm text-primary hover:underline">Detail →</span>
                                    </a>
                                ))}
                            </div>
                        </section>
                    );
                })
            }
        </div>

        <div class="mt-10">
            <Button asChild variant="secondary"><a href={withBase('/resources/')}>Lihat resource & tautan →</a></Button>
        </div>
    </div>
</BaseLayout>
