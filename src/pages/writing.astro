---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/ui/button';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Writing" description="Tulisan, panduan, dan catatan teknis oleh Nilma, M.Kom.">
    <div class="mx-auto max-w-6xl px-6 py-20">
        <h1 class="text-4xl font-bold tracking-tight">Writing</h1>
        <p class="mt-3 text-muted-foreground">Panduan, catatan kuliah, dan tulisan teknis yang saya tulis.</p>

        <ul class="mt-10 divide-y divide-border">
            {
                posts.map((p) => (
                    <li>
                        <a
                            href={`/writing/${p.id}/`}
                            class="group flex flex-wrap items-baseline justify-between gap-2 py-4"
                        >
                            <div>
                                <p class="font-medium text-foreground group-hover:text-primary">{p.data.title}</p>
                                <span class="text-xs text-muted-foreground">{p.data.tags.join(' · ')}</span>
                            </div>
                            <time class="text-sm text-muted-foreground">{p.data.date.toLocaleDateString('id-ID')}</time>
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="mt-10">
            <Button asChild variant="secondary"><a href="/rhcsa/">Buka dokumentasi lengkap →</a></Button>
        </div>
    </div>
</BaseLayout>
