---
import { site } from '@/lib/site';
---

<footer class="border-t border-border/60">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-6 py-8 text-sm text-muted-foreground sm:flex-row">
    <p>© {new Date().getFullYear()} {site.fullName}. Dibangun dengan Astro & Starlight.</p>
    <div class="flex gap-4">
      <a href="/guides/contoh/" class="hover:text-foreground">Docs</a>
      <a href={site.socials.github} class="hover:text-foreground">GitHub</a>
      <a href={site.socials.linkedin} class="hover:text-foreground">LinkedIn</a>
    </div>
  </div>
</footer>
