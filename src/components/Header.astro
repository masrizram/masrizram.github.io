---
import { site, nav, docsHref } from '@/lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const isDocsActive =
  path.startsWith('/rhcsa/') ||
  path.startsWith('/pentester/') ||
  path.startsWith('/koding/') ||
  path.startsWith(docsHref);
---

<!--
  Header docs DISAMAKAN PERSIS dengan site utama (BaseLayout):
  <header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
  logo KIRI (Nilma.) → menu KANAN (Home/About/.../Contact/Docs) → theme toggle.
  Mobile: hamburger <details class="lg:hidden"> seperti home.
  Dark mode SAMA dengan home (.dark + localStorage "theme").
  Search sengaja di-hide agar identik dengan home.
-->
<header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="text-lg font-semibold tracking-tight">Nilma<span class="text-primary">.</span></a>

    <!-- desktop nav -->
    <nav class="hidden items-center gap-5 text-sm text-muted-foreground lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "transition-colors hover:text-foreground",
            isActive(item.href) && "font-medium text-foreground",
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href={docsHref} class:list={["transition-colors hover:text-foreground", isDocsActive && "font-medium text-foreground"]}>Docs</a>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Ubah tema"
        class="inline-flex size-9 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
    </nav>

    <!-- mobile nav -->
    <details class="lg:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-border px-3 py-1.5 text-sm text-muted-foreground">Menu</summary>
      <div class="absolute right-4 mt-2 w-52 rounded-lg border border-border bg-card p-2 shadow-lg">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "block rounded-md px-3 py-2 text-sm transition-colors hover:bg-muted",
              isActive(item.href) && "font-medium text-foreground",
            ]}
          >{item.label}</a>
        ))}
        <a href={docsHref} class:list={["block rounded-md px-3 py-2 text-sm transition-colors hover:bg-muted", isDocsActive && "font-medium text-foreground"]}>Docs</a>
      </div>
    </details>
  </div>
</header>

<script>
  import '../scripts/theme';
</script>