---
import { nav, site } from '@/lib/site';
import { withBase } from '@/lib/utils';

const path = Astro.url.pathname.replace(/index\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (item: { href: string; match?: string[] }) => {
    const base = withBase('/').replace(/\/$/, '') || '/';
    if (item.match) return item.match.some((p) => path.startsWith(withBase(p).replace(/\/$/, '')));
    if (item.href === '/') return path === '/' || path === base;
    return path.startsWith(withBase(item.href).replace(/\/$/, ''));
};
---

<!--
  Header docs DISAMAKAN PERSIS dengan site utama (BaseLayout):
  <header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
  logo KIRI (wordmark nama pendek) → menu KANAN (Home/About/.../Contact/Docs) → theme toggle.
  Mobile: hamburger <details class="lg:hidden"> seperti home.
  Dark mode SAMA dengan home (.dark + localStorage "theme").
  Search sengaja di-hide agar identik dengan home.
-->
<header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href={withBase('/')} class="text-lg font-semibold tracking-tight"
            >{site.shortName}<span class="text-primary">.</span></a
        >

        <!-- desktop nav -->
        <nav class="hidden items-center gap-5 text-sm text-muted-foreground lg:flex">
            {
                nav.map((item) => (
                    <a
                        href={withBase(item.href)}
                        class:list={[
                            'transition-colors hover:text-foreground',
                            isActive(item) && 'font-medium text-foreground',
                        ]}
                        aria-current={isActive(item) ? 'page' : undefined}
                    >
                        {item.label}
                    </a>
                ))
            }
            <button
                id="theme-toggle"
                type="button"
                aria-label="Ubah tema"
                class="inline-flex size-9 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="hidden dark:block"
                    ><circle cx="12" cy="12" r="4"></circle><path
                        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                    ></path></svg
                >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="block dark:hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
                >
            </button>
        </nav>

        <!-- mobile nav -->
        <details class="lg:hidden">
            <summary
                class="cursor-pointer list-none rounded-md border border-border px-3 py-1.5 text-sm text-muted-foreground"
                >Menu</summary
            >
            <div class="absolute right-4 mt-2 w-52 rounded-lg border border-border bg-card p-2 shadow-lg">
                {
                    nav.map((item) => (
                        <a
                            href={withBase(item.href)}
                            class:list={[
                                'block rounded-md px-3 py-2 text-sm transition-colors hover:bg-muted',
                                isActive(item) && 'font-medium text-foreground',
                            ]}
                        >
                            {item.label}
                        </a>
                    ))
                }
            </div>
        </details>
    </div>
</header>

<script>
    import '../scripts/theme';
</script>
