---
import { site } from '@/lib/site';
---

<!-- Logo docs IDENTIK dengan home: "Nilma." -->
<a href="/" class="site-title sl-flex">
  <span class="site-title__name">{site.name}<span class="site-title__dot">.</span></span>
</a>

<style>
  .site-title {
    gap: 0.5rem;
    align-items: baseline;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-foreground);
    line-height: 1;
  }
  .site-title__name {
    font-size: 1.05rem;
  }
  .site-title__dot {
    color: var(--color-primary);
  }
</style>
