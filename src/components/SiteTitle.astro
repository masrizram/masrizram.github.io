---
import { site } from '@/lib/site';
import { withBase } from '@/lib/utils';
---

<!-- Logo docs IDENTIK dengan home: wordmark nama pendek + titik aksen. -->
<a href={withBase('/')} class="site-title sl-flex">
    <span class="site-title__name">{site.shortName}<span class="site-title__dot">.</span></span>
</a>

<style>
    .site-title {
        gap: 0.5rem;
        align-items: baseline;
        font-weight: 600;
        text-decoration: none;
        color: var(--color-foreground);
        line-height: 1;
    }
    .site-title__name {
        font-size: 1.05rem;
    }
    .site-title__dot {
        color: var(--color-primary);
    }
</style>
