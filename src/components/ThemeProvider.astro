---
// Override ThemeProvider Starlight: initial apply TANPA flicker (inline, sebelum paint).
// Toggle & sinkronisasi lain ditangani di src/scripts/theme.ts (di-load Header.astro).
---

<script is:inline>
    (function () {
        const root = document.documentElement;
        let t = null;
        try {
            t = localStorage.getItem('theme');
        } catch (e) {
            /* localStorage tidak tersedia (private mode) */
        }
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            root.classList.add('dark');
            root.dataset.theme = 'dark';
        } else {
            root.classList.remove('dark');
            root.dataset.theme = 'light';
        }
        // Puaskan Starlight agar tidak menimpa theme kita.
        window.StarlightThemeProvider = { updatePickers() {} };
    })();
</script>
