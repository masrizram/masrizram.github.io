# Salin file ini ke `.env` dan isi URL produksi situs Anda.
# Digunakan saat `npm run build` / `npm run dev` untuk canonical, OG, & sitemap.
# Untuk ROOT murni (/) dari repo `website`, wajib custom domain (set SITE_URL + public/CNAME).
# Contoh:
#   SITE_URL=https://xaisyndicate.net          # custom domain → base '/'
#   SITE_URL=https://nilma.my.id               # custom domain → base '/'
#   SITE_URL=https://masrizram.github.io       # GH user page  → base '/' (rename repo ke masrizram.github.io)
#   SITE_URL=https://masrizram.github.io/website  # GH project page → base '/website'
SITE_URL=https://masrizram.github.io
